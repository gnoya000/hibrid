# ==========================================================================
# Root .gitignore for the hibrid monorepo (hibrid-app + hibrid-engine)
# ==========================================================================

# --- OS / Editor ---------------------------------------------------------
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea
.vscode/*
!.vscode/extensions.json

# --- Environment / secrets ----------------------------------------------
*.local
.env
.env.*
!.env.example
.dev.vars

# ==========================================================================
# hibrid-app (Node / Vite / Bun / Cloudflare)
# ==========================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules/
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro

# Wrangler / Cloudflare
.wrangler/

# ==========================================================================
# hibrid-engine (Python)
# ==========================================================================
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Claude local settings
.claude/settings.local.json

# ==========================================================================
# graphify output (generated knowledge graph / cache)
# ==========================================================================
graphify-out/cache/
graphify-out/cache/
