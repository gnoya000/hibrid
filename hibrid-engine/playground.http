### One reading is UNKNOWN, not "fine". The distinction is load-bearing.
#
# A z-score off a single reading is noise, so the engine declines to judge --
# and says so, rather than reporting a clean bill of health it did not earn.
# Same for a baseline under 7 readings, or a newest reading over 48h old.
#
# Observed: readiness.state = unknown, load_multiplier = 1.0, comparisons = [].
# The routine varies normally; nothing is deloaded.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "recovery_history": [
      {
        "user_id": "11111111-1111-1111-1111-111111111111",
        "recorded_at": "2026-08-09T03:00:00Z",
        "hrv_rmssd_ms": 20.0
      }
    ],
    "as_of": "2026-08-09T07:00:00Z"
  },
  "seed": 3
}

### Illness needs no baseline at all.
#
# Illness is not a z-score -- a user has no normal amount of fever to deviate
# from -- so the flag stands alone with zero history. It short-circuits
# straight to the strongest cutback.
#
# Observed: readiness.state = strongly_suppressed, load_multiplier = 0.75,
# flags = ["illness_reported"]. 4x8@80 -> 3x12@52.5. Volume 2560 -> 1890,
# time 456 -> 453 (still held).
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench day",
    "entries": [
      {
        "exercise_id": "barbell-bench-press",
        "dose": {
          "kind": "reps",
          "sets": 4,
          "reps": 8,
          "weight": 80
        }
      }
    ]
  },
  "context": {
    "wellness_history": [
      {
        "user_id": "11111111-1111-1111-1111-111111111111",
        "recorded_at": "2026-08-09T03:00:00Z",
        "illness_reported": true
      }
    ],
    "as_of": "2026-08-09T07:00:00Z"
  },
  "seed": 3,
  "substitution_prob": 0
}

### A deload reaches an entry the scheme search refuses to touch.
#
# 4x30 sits outside hypertrophy's 8-15 rep range, so candidate_rep_schemes
# returns nothing and the entry is normally left alone with
# dose_outcome = unvaried_no_scheme_in_objective_range (that is a settled
# decision -- the search does not chase the range). A deload still has to land,
# so under a reduced target the current scheme becomes a legal candidate: same
# sets and reps, lighter load.
#
# Observed: 4x30@20 -> 4x30@17.5, dose_outcome = varied_for_strain.
# Volume 2400 -> 2100 (-12.5%), time 720 held exactly.
POST {{host}}/vary
Content-Type: application/json

{
