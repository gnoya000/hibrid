# hibrid — API scenario suite
#
# For the VS Code REST Client extension (humao.rest-client): click "Send Request"
# above any block below.
#
#   source .venv/bin/activate
#   pip install -e ".[dev,api]"
#   python -m hibrid.api          # serves on :8000, Swagger UI at /docs
#
# Every "observed" note below was measured against the engine, seeds included.
# They are documentation of real behaviour, not assertions -- if one stops
# matching after an engine change, that is the suite doing its job.
#
#   1-6  the endpoints and the engine's knobs
#   7    where the algorithm's actual limits show up -- read before trusting output
#   8    input handling
#   9    user context: health, equipment and preferences
#   10   training memory: what the user actually did
#   11   progression: variation becomes programming
#   12   load management: the block, not the session
#   13   session generation from scratch, and re-rolling one block

@host = http://localhost:8000
@ppl = example_ppl
@mixed = example_mixed


###############################################################################
# 1. DISCOVERY — what is there
###############################################################################

### Liveness.
GET {{host}}/health

### Every implemented objective strategy, with its real parameters.
# Observed: 3 strategies. strength rep_range [1,6] rest [120,300] tempo 2.5s;
# hypertrophy [8,15] rest [60,120] tempo 3.0s; muscular_endurance [15,25]
# rest [20,60] tempo 2.0s. The other 10 TrainingObjective values (cardiovascular
# endurance, flexibility, agility, ...) have no strategy yet -- see section 8.
GET {{host}}/objectives

### Routines available on disk (routines/*.yaml).
# Observed: example_ppl (5 entries), example_mixed (3 entries).
GET {{host}}/routines

### One routine, fully resolved: exercise names, per-entry volume and time.
GET {{host}}/routines/{{ppl}}

### The mixed-modality routine — three different dose shapes in one file.
# This is the M1 milestone fixture: barbell squat + 1km run + 60s stretch.
GET {{host}}/routines/{{mixed}}

### Unknown routine name.
# Observed: 404.
GET {{host}}/routines/no-such-routine


###############################################################################
# 2. OBJECTIVE COMPARISON — the core of the playground
#
# Same routine, same seed, substitution off, so the ONLY variable is the
# objective. Run all four and diff the `describe` fields.
#
# Original:            4x8@80 r120 | 4x8@45 r90 | 3x10@27.5 r90 | 3x12@10 r60 | 3x12@25 r60
# strength:            (unchanged) | (unchanged) | (unchanged) | (unchanged) | (unchanged)
# hypertrophy:         5x10@50 r85 | 3x9@52.5 r120 | 3x13@20 r80 | 3x10@12.5 r65 | 3x13@22.5 r60
# muscular_endurance:  (unchanged) | (unchanged) | (unchanged) | 3x16@7.5 r60 | 4x15@15 r40
#
# The "(unchanged)" entries are not a bug and not randomness -- see section 7.
#
# STRENGTH NOW HOLDS EVERY ENTRY, and that is the correct answer rather than a
# regression. This is an 8-rep hypertrophy routine: strength preserves *load*
# rather than volume, so it will not re-solve 4x8@80 into a heavier low-rep
# scheme, and the only volume-equivalent schemes at 80 kg are blocked by the
# 120s rest floor. Each entry reports `unvaried_holding_intensity` and says so.
# Every one of them previously came back as a load the lifter could not lift --
# see section 7(d), which used to document that as a live limitation.
#
# To see strength actually vary, give it a routine already in its rep range
# (section 7(d) below), or generate one with POST /sessions/generate.
###############################################################################

### Baseline: what we are varying.
GET {{host}}/routines/{{ppl}}

### STRENGTH — low reps, heavy, long rest.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "strength",
  "seed": 3,
  "substitution_prob": 0.0
}

### HYPERTROPHY — moderate reps and rest. This is the default objective.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "hypertrophy",
  "seed": 3,
  "substitution_prob": 0.0
}

### MUSCULAR ENDURANCE — high reps, light, short rest.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "muscular_endurance",
  "seed": 3,
  "substitution_prob": 0.0
}

### Objective omitted entirely — defaults to hypertrophy.
# Observed: byte-identical to the hypertrophy request above.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0
}


###############################################################################
# 3. DETERMINISM AND SEEDS
###############################################################################

### Send this twice — the varied ENTRIES must be identical.
# Observed: identical. Note `routine_id` differs every call: a variation is a
# new Routine and gets a fresh UUID (M1), so compare entries, not the whole body.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "hypertrophy",
  "seed": 7
}

### Seed 1, substitution forced on.
# Observed: Trap Bar Bottoms Up Bench Press / Kettlebell seated two arm military
# press / Dumbbell Crush Grip Floor Press / Double Dumbbell Tall Kneeling Lateral
# Raise / Single Arm Dumbbell Incline Bench Skull Crusher
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 1,
  "substitution_prob": 1.0
}

### Seed 2 — same request, different draw.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 2,
  "substitution_prob": 1.0
}

### Seed 3.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 1.0
}

### No seed at all — a different result every send.
# The only non-reproducible request in this file. Send it repeatedly to get a
# feel for the spread of substitutions the library actually offers.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "substitution_prob": 1.0
}


###############################################################################
# 4. SUBSTITUTION BEHAVIOUR
###############################################################################

### substitution_prob = 0 — schemes change, exercises never do.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0
}

### substitution_prob = 0.5 — roughly half the entries swap.
# Observed (seed 3): entries 1, 3 and 4 swapped; 2 and 5 kept their exercise.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.5
}

### substitution_prob = 1.0 — every entry swaps.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 1.0
}

### allow_equipment_change = false — substitutes must keep the same equipment.
# Observed (seed 5): barbell bench -> "Barbell Incline Push Up" (still barbell),
# dumbbell press -> a dumbbell press, cable pushdown -> a cable extension.
# Compare against the next request, which is the same seed unrestricted.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 50,
  "substitution_prob": 1.0,
  "allow_equipment_change": false
}

### Same seed, equipment change allowed — barbell bench can become a kettlebell
### floor press, the cable pushdown a dumbbell skull crusher.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 5,
  "substitution_prob": 1.0,
  "allow_equipment_change": true
}

### The bodyweight boundary: a loaded exercise is never swapped for a bodyweight
### one, and vice versa, because the engine solves a weight from volume and an
### "implied load" for a push-up is meaningless.
# Observed: chest dip (bodyweight) -> "Clap push up" (also bodyweight).
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bodyweight only",
    "entries": [
      { "exercise_id": "chest-dip", "dose": { "kind": "reps", "sets": 4, "reps": 10, "weight": 0 } }
    ]
  },
  "seed": 1,
  "substitution_prob": 0.5
}


###############################################################################
# 5. THE ENGINE'S TUNING KNOBS
###############################################################################

### volume_tolerance = 0 — only schemes preserving volume EXACTLY are accepted.
# Observed: 1 of 5 entries unchanged; the rest found exact rearrangements
# (e.g. 4x8@45 -> 4x9@40, both 1440). Tighter is not always less variation.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "volume_tolerance": 0.0
}

### volume_tolerance = 0.075 (the default).
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "volume_tolerance": 0.075
}

### volume_tolerance = 0.5 — very loose.
# Observed: identical to the default here. The search takes the FIRST candidate
# inside tolerance from a shuffled list, so loosening past the point where a
# candidate already qualifies changes nothing.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "volume_tolerance": 0.5
}

### time_tolerance = 0 — session length must be preserved exactly.
# Observed: 4 of 5 entries unchanged. Time is usually the binding constraint,
# not volume.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "time_tolerance": 0.0
}

### time_tolerance = 0.25, strength — loosening time unlocks entries that the
### strength rest floor (120s minimum) had blocked.
# Observed: entry 1 goes 4x8@80 -> 5x6@80, impossible at the default 0.10. Note
# the load is unchanged: strength preserves intensity, so loosening the time
# tolerance buys a different scheme at the same bar, never a heavier one.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "strength",
  "seed": 3,
  "substitution_prob": 0.0,
  "time_tolerance": 0.25
}

### weight_increment = 1.0 — fine-grained plates.
# Observed: 5x10@51, 3x9@53, 3x13@21 ... precise but not gym-realistic.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "weight_increment": 1.0
}

### weight_increment = 20.0 — very coarse. Fewer schemes can hit the volume
### target, so more entries stay unchanged.
# Observed: 1 of 5 entries unchanged.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 3,
  "substitution_prob": 0.0,
  "weight_increment": 20.0
}


###############################################################################
# 6. DOSE SHAPES AND MODALITY GUARDS
###############################################################################

### All four dose shapes in one routine.
# Observed: only the barbell squat (RepsDose, resistance) is varied. The run,
# the stretch and the rounds block pass through byte-identical under EVERY
# objective -- V1 has no search for distance/duration/rounds doses yet.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "All four dose shapes",
    "entries": [
      { "exercise_id": "barbell-front-squat", "dose": { "kind": "reps", "sets": 4, "reps": 6, "weight": 90 }, "rest_seconds": 120 },
      { "exercise_id": "run", "dose": { "kind": "distance", "distance_m": 1000, "duration_seconds": 300 }, "rest_seconds": 60 },
      { "exercise_id": "lying-side-quads-stretch", "dose": { "kind": "duration", "sets": 1, "duration_seconds": 60 }, "rest_seconds": 0 },
      { "exercise_id": "burpee", "dose": { "kind": "rounds", "rounds": 5, "round_seconds": 45 }, "rest_seconds": 15 }
    ]
  },
  "objective": "hypertrophy",
  "seed": 1,
  "substitution_prob": 0.0
}

### The same routine under strength — confirm the three non-resistance entries
### are still untouched.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "All four dose shapes",
    "entries": [
      { "exercise_id": "barbell-front-squat", "dose": { "kind": "reps", "sets": 4, "reps": 6, "weight": 90 }, "rest_seconds": 120 },
      { "exercise_id": "run", "dose": { "kind": "distance", "distance_m": 1000, "duration_seconds": 300 }, "rest_seconds": 60 },
      { "exercise_id": "lying-side-quads-stretch", "dose": { "kind": "duration", "sets": 1, "duration_seconds": 60 }, "rest_seconds": 0 },
      { "exercise_id": "burpee", "dose": { "kind": "rounds", "rounds": 5, "round_seconds": 45 }, "rest_seconds": 15 }
    ]
  },
  "objective": "strength",
  "seed": 1,
  "substitution_prob": 0.0
}

### The modality guard: a CARDIO exercise carrying a RepsDose, under a
### RESISTANCE objective. The dose shape is variable but the exercise's
### modality does not match the strategy's preferred_modality.
# Observed: unchanged. This is the `preferred_modality` check in vary_entry.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Cardio exercise with a rep dose",
    "entries": [
      { "exercise_id": "burpee", "dose": { "kind": "reps", "sets": 4, "reps": 10, "weight": 0 } }
    ]
  },
  "objective": "hypertrophy",
  "seed": 1,
  "substitution_prob": 0.0
}

### Substitution still applies to entries whose dose cannot be varied.
# Observed: jump-rope -> "Walk elliptical cross trainer" (cardio stays cardio),
# while the rounds dose passes through unchanged. Swapping the exercise and
# varying the dose are independent steps.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Cardio, substitution on",
    "entries": [
      { "exercise_id": "jump-rope", "dose": { "kind": "rounds", "rounds": 3, "round_seconds": 60 } }
    ]
  },
  "seed": 1,
  "substitution_prob": 1.0
}

### A named mixed routine end to end.
# Observed (strength, seed 2): all three entries unchanged. The squat holds at
# 4x6@90 (`unvaried_holding_intensity` -- strength will not re-solve it to
# 4x4@135 as it once did); run and stretch are untouched as non-reps doses.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_mixed",
  "objective": "strength",
  "seed": 2,
  "substitution_prob": 0.0
}


###############################################################################
# 7. WHAT THE PLAYGROUND ACTUALLY REVEALS
#
# Four real behaviours worth understanding before trusting any output.
#
# Every varied entry now carries `dose_outcome`, `dose_outcome_reason` and
# `exercise_substituted`, so the cases below are self-describing in the
# response rather than something you have to infer by diffing. The outcomes:
#
#   varied                                 the scheme moved
#   unvaried_not_reps_dose                 duration/distance/rounds dose --
#                                          no search exists for these yet
#   unvaried_modality_mismatch             exercise is not in the modality
#                                          this objective prescribes in
#   unvaried_no_scheme_in_objective_range  search stays near the current
#                                          scheme; nothing nearby is in range
#   unvaried_no_candidate_within_tolerance schemes existed, none preserved
#                                          both volume and time
#
# `exercise_substituted` is independent of all of these: an entry can be
# swapped for a different exercise while its dose passes through untouched.
###############################################################################

### (a) THE SEARCH RADIUS CAPS HOW FAR AN OBJECTIVE CAN PULL A SCHEME.
#
# candidate_rep_schemes searches +/-2 sets and +/-4 reps around the CURRENT
# scheme, then clips to the objective's range. An entry at 8 reps can therefore
# only reach 12 -- it can never enter muscular endurance's 15-25 window, so it
# is returned unchanged rather than moved partway.
#
# Observed below: entries starting at 8 and 10 reps report
# `unvaried_no_scheme_in_objective_range`; only the two 12-rep entries (which
# can reach 15-16) come back `varied`. This staying-near-the-current-scheme
# behaviour is deliberate -- a user's objective is broadly fixed, and what
# matters is micro-varying their routine, not jumping it across rep ranges.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "muscular_endurance",
  "seed": 3,
  "substitution_prob": 0.0
}

### (b) THE SAME ROUTINE, PRE-MOVED INTO RANGE, VARIES FREELY.
#
# Identical exercises and objective as (a), but starting at 15 reps instead of
# 8. Now every entry has candidates. This isolates the radius as the cause.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Already in the endurance range",
    "entries": [
      { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 3, "reps": 15, "weight": 45 }, "rest_seconds": 45 },
      { "exercise_id": "cable-pushdown", "dose": { "kind": "reps", "sets": 3, "reps": 18, "weight": 15 }, "rest_seconds": 40 }
    ]
  },
  "objective": "muscular_endurance",
  "seed": 3,
  "substitution_prob": 0.0
}

### (c) OBJECTIVE CONSTRAINTS CAN CONTRADICT TIME PRESERVATION.
#
# Strength wants >=120s rest; the entry below is prescribed at 60s. Holding
# entry time constant while raising rest to the floor overshoots the time
# tolerance, so the candidate is rejected and the entry is returned unchanged.
# Raise time_tolerance to 0.25 (section 5) and it moves.
#
# Observed: unchanged at the default 0.10, reported as
# `unvaried_no_candidate_within_tolerance` -- schemes existed, none fit.
# Contrast with (a), where no scheme was ever generated.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Short rest meets strength's rest floor",
    "entries": [
      { "exercise_id": "cable-pushdown", "dose": { "kind": "reps", "sets": 3, "reps": 12, "weight": 25 }, "rest_seconds": 60 }
    ]
  },
  "objective": "strength",
  "seed": 3,
  "substitution_prob": 0.0
}

### (d) VOLUME EQUIVALENCE IS NOT LOAD EQUIVALENCE -- **FIXED.** Read anyway.
#
# This request used to be the sharpest limitation in the playground. Holding
# sets x reps x weight constant meant halving the reps doubled the load, so the
# 4x8@80 bench press below came back as 4x4@160 -- arithmetically equal volume,
# physiologically impossible for the same lifter. The full candidate set spanned
# 6x6@45 to 3x1@532.5, all of them reported as a successful variation.
#
# Fixed by making the invariant the objective's choice. StrengthStrategy now
# declares `Invariant.INTENSITY`, so the load is pinned at the reference and the
# scheme moves around it instead of the other way round.
#
# Observed now: 4x8@80 -> 4x8@80, `unvaried_holding_intensity`. Strength will not
# invent a heavier scheme, and 8 reps is outside its 1-6 range so it has nothing
# in-range to move to either. The honest answer is to leave it alone and say why.
#
# Try it with an in-range strength routine to see it vary properly: a 4x4@100
# entry returns 3x5@100 or 5x3@100 -- same bar, different scheme.
#
# The residual limit worth knowing: nothing bounds a *generated* candidate load
# against the user's estimated 1RM. Under LOAD_VOLUME (hypertrophy, endurance)
# the load is still solved from volume and can still drift away from what the
# lifter can handle, which is why heavy hypertrophy output is still a scheme
# suggestion rather than a prescription.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Volume-equivalent, load-absurd",
    "entries": [
      { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 80 }, "rest_seconds": 120 }
    ]
  },
  "objective": "strength",
  "seed": 3,
  "substitution_prob": 0.0
}

### (e) The invariant that DOES hold: routine totals stay within tolerance.
# Observed (seed 9): volume 6085 -> 6070 (0.2%), time 1968 -> 1988 (1.0%).
# Check `total_volume` and `total_time_seconds` on both objects.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "seed": 9
}


###############################################################################
# 8. INPUT HANDLING
###############################################################################

### Objective with no strategy implemented yet.
# Observed: 400 with the available list. Ten of the thirteen TrainingObjective
# values land here -- they need a duration/distance search that does not exist.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "cardiovascular_endurance"
}

### Objective that is not a TrainingObjective at all.
# Observed: 422, caught by the enum before reaching the route.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objective": "not_a_real_objective"
}

### Both routine and routine_name — ambiguous.
# Observed: 422 from VaryRequest's validator.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "routine": { "name": "x", "entries": [ { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 3, "reps": 8, "weight": 80 } } ] }
}

### Neither routine nor routine_name.
# Observed: 422.
POST {{host}}/vary
Content-Type: application/json

{
  "seed": 1
}

### Empty entries list.
# Observed: 422, too_short at body.routine.entries.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": { "name": "Empty", "entries": [] }
}

### sets = 0.
# Observed: 422, greater_than at body.routine.entries.0.dose.reps.sets.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Zero sets",
    "entries": [ { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 0, "reps": 8, "weight": 80 } } ]
  }
}

### Negative weight.
# Observed: 422, greater_than_equal.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Negative load",
    "entries": [ { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 3, "reps": 8, "weight": -5 } } ]
  }
}

### Dose kind that does not exist.
# Observed: 422, union_tag_invalid — the discriminated union names the four
# legal kinds in the error.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bad dose kind",
    "entries": [ { "exercise_id": "barbell-bench-press", "dose": { "kind": "tabata", "sets": 3 } } ]
  }
}

### Dose with no `kind` discriminator.
# Observed: 422, union_tag_not_found.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Missing discriminator",
    "entries": [ { "exercise_id": "barbell-bench-press", "dose": { "sets": 3, "reps": 8, "weight": 80 } } ]
  }
}

### Misspelled field — extra="forbid" means typos raise instead of being
### silently ignored and defaulted.
# Observed: 422, extra_forbidden at body.objectiv.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "objectiv": "strength"
}

### substitution_prob outside [0, 1].
# Observed: 422, less_than_equal.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "substitution_prob": 1.5
}

### Negative tolerance.
# Observed: 422, greater_than_equal.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "volume_tolerance": -0.1
}

### Unknown exercise_id.
# Observed: 400 with the offending id. ExerciseDB raises a typed
# UnknownExerciseError, which the app translates rather than letting a bare
# KeyError escape as a 500 (which is what this did before the fix).
#
# See section 9 for the user-context cases, including the typo'd health field
# that must be rejected rather than silently dropped.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Typo'd exercise id",
    "entries": [ { "exercise_id": "no-such-exercise", "dose": { "kind": "reps", "sets": 3, "reps": 8, "weight": 80 } } ]
  },
  "substitution_prob": 0.0
}


###############################################################################
# 9. USER CONTEXT
#
# The engine finally reads the V2 user schema. Context travels *with* the
# request -- there is no user store, and whoever invokes a variation (the user,
# or a coach with access to these data points) sends what the algorithm needs.
#
# `context` carries the real hibrid.user models, not a flattened copy, so
# there is no second schema to drift and extra="forbid" rejects a typo instead
# of quietly dropping a health constraint.
#
# Four tiers, which are NOT interchangeable:
#   inviolable  context.health           never traded against an objective
#   hard        equipment, excluded_*    violating one = cannot be executed
#   soft        disliked_*, novelty      violating one = will not be enjoyed
#   adaptive    recovery_history,        does not filter ANYTHING -- it scales
#               wellness_history         how much load the permitted work carries
#
# Each varied entry reports an `exercise_outcome`:
#   kept / substituted_for_variety / substituted_for_constraint /
#   blocked_no_legal_alternative   (the last sets is_unsafe = true)
#
# The response also carries `context_filter`, so an over-restrictive context is
# visible rather than masked as "the engine found nothing", and `readiness`,
# so a routine that came back lighter says why. Section 9b covers that.
#
# NOT read, deliberately: MedicalConsideration's structured effect flags
# (limits_overhead_work, limits_high_impact, ...), session-duration budgets,
# and accumulated training load.
###############################################################################

### THE MILESTONE: active shoulder injury + dumbbells only.
#
# The routine prescribes exactly what this user must not receive. Both tiers
# bind at once: the injury rules out the vertical_push pattern, the equipment
# rules out the barbell.
#
# Observed (seed 4): Barbell Overhead Press -> Dumbbell cuban press v. 2,
# exercise_outcome = substituted_for_constraint, is_unsafe = false.
# context_filter: 682 of 4531 permitted.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Overhead day",
    "entries": [
      { "exercise_id": "barbell-overhead-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 50 } }
    ]
  },
  "context": {
    "health": {
      "injuries": [
        {
          "body_region": "shoulder",
          "status": "active",
          "severity": 6,
          "contraindicated_movement_patterns": ["vertical_push"]
        }
      ]
    },
    "preferences": {
      "equipment_access": [
        { "environment": "home_gym", "available_equipment": ["dumbbell"], "is_default": true }
      ]
    }
  },
  "seed": 4
}

### The control: same routine, no context. Nothing forces the swap.
# Confirms the milestone above passes for the right reason.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Overhead day",
    "entries": [
      { "exercise_id": "barbell-overhead-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 50 } }
    ]
  },
  "seed": 4,
  "substitution_prob": 0.0
}

### Safety overrides the novelty dial: substitution_prob = 0 does NOT keep a
### contraindicated exercise. Swapping for safety is not a stylistic choice.
# Observed: still substituted_for_constraint.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench",
    "entries": [
      { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 80 } }
    ]
  },
  "context": {
    "health": { "injuries": [ { "body_region": "shoulder", "status": "active",
                 "contraindicated_exercise_ids": ["barbell-bench-press"] } ] }
  },
  "seed": 1,
  "substitution_prob": 0.0
}

### When NOTHING legal exists, the engine says so instead of pretending.
# A user with no equipment at all. Variation cannot drop an entry, so the
# contraindicated exercise stays in the output -- flagged.
# Observed: exercise_outcome = blocked_no_legal_alternative, is_unsafe = true.
# Anything rendering this MUST check is_unsafe.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench",
    "entries": [
      { "exercise_id": "barbell-bench-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 80 } }
    ]
  },
  "context": {
    "preferences": { "equipment_access": [ { "environment": "bodyweight_only",
                      "available_equipment": [], "is_default": true } ] }
  },
  "seed": 1
}

### max_load_kg bounds the solved weight.
# A 20kg dumbbell rack cannot deliver a volume-preserving 60kg solution.
# Observed: dose_outcome = unvaried_load_exceeds_equipment, which is reported
# distinctly from an ordinary tolerance failure.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Heavy",
    "entries": [
      { "exercise_id": "dumbbell-bench-press", "dose": { "kind": "reps", "sets": 4, "reps": 8, "weight": 60 } }
    ]
  },
  "context": {
    "preferences": { "equipment_access": [ { "environment": "home_gym",
                      "available_equipment": ["dumbbell"], "max_load_kg": 20, "is_default": true } ] }
  },
  "seed": 1,
  "substitution_prob": 0.0
}

### Environment selects which inventory applies.
# Access is per environment. Ask as "hotel_gym" when the user has no record
# for it and you get NOTHING available -- not a silent fallback to their home
# rack, which would prescribe equipment they do not have where they are.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "preferences": {
      "equipment_access": [
        { "environment": "home_gym", "available_equipment": ["dumbbell"], "is_default": true },
        { "environment": "commercial_gym", "available_equipment": ["barbell", "cable", "machine"] }
      ]
    },
    "environment": "commercial_gym"
  },
  "seed": 2
}

### A dislike is a COST, not an exclusion.
# Disliked exercises stay legal and can still be chosen if markedly more
# suitable than the alternatives; they simply drop out of the tied top band.
# Compare `exercise_name` against the same seed without the dislikes.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "preferences": {
      "disliked_exercise_ids": ["barbell-incline-bench-press", "dumbbell-incline-bench-press"]
    }
  },
  "seed": 3,
  "substitution_prob": 1.0
}

### excluded_exercise_ids IS a hard exclusion — the schema separates the two.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "preferences": { "excluded_movement_patterns": ["horizontal_push"] }
  },
  "seed": 3
}

### novelty_preference drives substitution when substitution_prob is omitted.
# The schema names this as the dial substitution_prob should derive from
# rather than a hard-coded 0.3. Set 0.0 and nothing is swapped; set 1.0 and
# everything is. An explicit substitution_prob still wins.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": { "preferences": { "novelty_preference": 0.0 } },
  "seed": 1
}

### The same, at maximum novelty.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": { "preferences": { "novelty_preference": 1.0 } },
  "seed": 1
}

### A resolved injury must stop constraining.
# Prior injury stays in the schema (it predicts future injury) but must not
# still block movements. Observed: no constraint applied.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "health": {
      "injuries": [
        {
          "body_region": "shoulder",
          "status": "resolved",
          "resolved_date": "2025-01-01",
          "contraindicated_movement_patterns": ["vertical_push"]
        }
      ]
    }
  },
  "seed": 1
}

### WHY THE CONTEXT IS IN THE BODY: a typo'd health field is rejected.
# `contraindicated_movement_pattern` (singular) is not a field. In the body,
# extra="forbid" turns that into a 422. Carried as a header it would have been
# silently ignored -- meaning "this user has no contraindications" -- and they
# would have been prescribed the movement their injury forbids.
# Observed: 422, extra_forbidden.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "health": {
      "injuries": [
        {
          "body_region": "shoulder",
          "status": "active",
          "contraindicated_movement_pattern": ["vertical_push"]
        }
      ]
    }
  }
}

### An over-restrictive context is visible, not mysterious.
# Check `context_filter` on any response above: permitted / total. A context
# that permits a handful of exercises produces valid-looking output that never
# changes -- which is indistinguishable from "the engine found no better
# scheme" unless the count is reported.
POST {{host}}/vary
Content-Type: application/json

{
  "routine_name": "example_ppl",
  "context": {
    "preferences": { "equipment_access": [ { "environment": "home_gym",
                      "available_equipment": ["kettlebell"], "is_default": true } ] }
  },
  "seed": 1
}

###############################################################################
# 9b. STRAIN
#
# The adaptive tier. Unlike the other three it filters nothing -- it scales how
# much load the permitted work carries. Sets, reps, exercises and session TIME
# are held; only the volume target moves, because a session's length comes from
# the user's calendar and not their HRV.
#
# `recovery_history` / `wellness_history` take the REAL hibrid.user models, and
# you must send the whole trailing window rather than today's reading: the
# verdict is a comparison against this user's own 28-day baseline, so a lone
# reading has nothing to be suppressed against. `as_of` pins the moment being
# planned for (defaults to now), which is what makes these requests repeatable.
#
# The response's `readiness` block carries state, load_multiplier and the raw
# BaselineComparison behind it. Entries re-solved against a reduced target
# report dose_outcome = varied_for_strain.
#
# states -> multiplier:  unknown 1.0 | normal 1.0 | suppressed 0.9 |
#                        strongly_suppressed 0.75
#
# NOT read, deliberately: vendor readiness_score / strain_score (opaque
# functions of the same HRV and heart-rate inputs -- counting them too would
# double-weight one piece of physiology), and everything about accumulated
# load across sessions.
###############################################################################

