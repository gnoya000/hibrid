          "reps": 8,
          "weight": 80
        }
      }
    ]
  },
  "history": {
    "user_id": "11111111-1111-1111-1111-111111111111",
    "as_of": "2026-08-09T07:00:00Z",
    "sessions": [
      {
        "user_id": "11111111-1111-1111-1111-111111111111",
        "performed_at": "2026-08-06T07:00:00Z",
        "status": "completed",
        "exercises": [
          {
            "exercise_id": "barbell-bench-press",
            "order_index": 0,
            "sets": [
              {
