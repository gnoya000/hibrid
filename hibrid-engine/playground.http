### THE DELOAD TRAP: last session was light, and must not become the new normal.
#
# Two sessions: 8x100 ten days ago, then 8x85 three days ago at RPE 6 -- a
# strain-reduced week. Reading LAST SESSION'S WEIGHT forward would treat 85 as
# the reference and compound the loss every session afterwards.
#
# The reference is derived from the estimated 1RM instead, which is a
# best-over-history figure, so the light week leaves it untouched.
#
# Observed: reference_load_kg = 100.0, NOT 85.0. The easy session is still read
# as a reason to progress -- from the real reference: working 102.5.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench day (written six weeks ago)",
    "entries": [
      {
        "exercise_id": "barbell-bench-press",
        "dose": {
          "kind": "reps",
          "sets": 4,
          "reps": 8,
          "weight": 80
        }
      }
    ]
  },
  "history": {
    "user_id": "11111111-1111-1111-1111-111111111111",
    "as_of": "2026-08-09T07:00:00Z",
    "sessions": [
      {
        "user_id": "11111111-1111-1111-1111-111111111111",
        "performed_at": "2026-07-30T07:00:00Z",
        "status": "completed",
        "exercises": [
          {
            "exercise_id": "barbell-bench-press",
            "order_index": 0,
            "sets": [
              {
                "exercise_id": "barbell-bench-press",
                "set_index": 0,
                "reps_completed": 8,
                "load_kg": 100.0,
                "rpe": 8.0
              }
            ]
          }
        ]
      },
      {
        "user_id": "11111111-1111-1111-1111-111111111111",
        "performed_at": "2026-08-06T07:00:00Z",
        "status": "completed",
        "exercises": [
          {
            "exercise_id": "barbell-bench-press",
            "order_index": 0,
            "sets": [
              {
                "exercise_id": "barbell-bench-press",
                "set_index": 0,
                "reps_completed": 8,
                "load_kg": 85.0,
                "rpe": 6.0
              }
            ]
          }
        ]
      }
    ]
  },
  "seed": 3,
  "substitution_prob": 0
}

### THE CONTROL: same routine, no history. The file's number stands.
#
# This is the compatibility guarantee -- every caller that supplies no history
# sees exactly the pre-M8b behaviour.
#
# Observed: progression = null (not a "no_history" decision -- nothing was
# consulted at all). Volume 2560 -> 2520, 4x8@80 -> 3x12@70.0,
# dose_outcome = varied.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench day (written six weeks ago)",
    "entries": [
      {
        "exercise_id": "barbell-bench-press",
        "dose": {
          "kind": "reps",
          "sets": 4,
          "reps": 8,
          "weight": 80
        }
      }
    ]
  },
  "seed": 3,
  "substitution_prob": 0
}


###############################################################################
# 12. LOAD MANAGEMENT -- the block, not the session
#
# The same session log as §10/§11, read per *session* rather than per exercise.
# Two inputs, both of which only ever scale the volume target DOWN:
#
#   acute:chronic ratio   this week's load against this user's own four-week
#                         average, from `history.sessions`
#   taper                 a dated `context.target_event`, inside a 14-day window
#
# The log is posted once, in `history`, and feeds both M8b (per-exercise
# remembered loads) and M8c (per-session accumulated load). Two copies of it in
# one request would be two chances for them to disagree.
#
# `chronic_load_7d_equivalent` is the four-week window NORMALISED to one week --
# that is what makes the ratio the conventional figure, near 1.0 for steady
# training. A raw 28-day total would put a steady trainee at 0.25.
#
# The metric is chosen, never mixed: `context.load_metric` is session_rpe
# (session_rpe x duration, the default, used below) or volume_load (reps x load
# on the sets). A log carrying neither yields no workload assessment at all
# rather than a silently substituted one.
###############################################################################

### (a) CONTROL: eleven sessions, every three days. A steady trainee.
#
# Observed: state "optimal", acute 1260 vs 1050 weekly average, ratio 1.20.
# load_multiplier 1.0, dose_outcome "varied" -- the engine looked and this week
# was ordinary. Note this is NOT the same output as posting no history at all,
# where `load_management` is null: "we checked" and "we did not look" are
# deliberately distinguishable.
POST {{host}}/vary
Content-Type: application/json

{
  "routine": {
    "name": "Bench day",
    "entries": [
      {"exercise_id": "barbell-bench-press", "dose": {"kind": "reps", "sets": 4, "reps": 8, "weight": 80}}
    ]
  },
  "history": {
